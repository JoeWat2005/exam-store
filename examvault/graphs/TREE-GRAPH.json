    {"id": "mapT", "label": "mapT operation", "description": "fmap over tree values (Functor).", "ctor-pattern": "(a -> b) -> T a -> T b", "files": ["trees/tree-functor.md"], "tags": ["operation", "functor"]},
    {"id": "count", "label": "count operation", "description": "Count occurrences of element / by predicate.", "ctor-pattern": "Eq a => a -> T a -> Int", "files": ["question-families/tree-counting-family.md"], "tags": ["operation"]},
    {"id": "fold", "label": "tree-fold operation", "description": "Catamorphism: replace constructors with operations.", "ctor-pattern": "foldBT/foldRose generalisation", "files": ["trees/tree-fold.md"], "tags": ["operation"]},
    {"id": "validate", "label": "validate operation", "description": "Predicate over tree (isBST, isNBranching, isBalanced).", "ctor-pattern": "T -> Bool", "files": ["question-families/tree-validation-family.md"], "tags": ["operation"]},
    {"id": "insert-bst", "label": "BST insert", "description": "Ord a => a -> BT a -> BT a preserving invariant.", "ctor-pattern": "3-way Ord guard", "files": ["archetypes/A11-bst-ops.md"], "tags": ["operation", "bst"]},
    {"id": "delete-bst", "label": "BST delete", "description": "Remove element preserving BST.", "ctor-pattern": "4-case: empty / leaf / one-child / two-children", "files": ["archetypes/A11-bst-ops.md"], "tags": ["operation", "bst"]},
    {"id": "member-bst", "label": "BST member", "description": "O(log n) membership.", "ctor-pattern": "Ord-guided recursion", "files": ["archetypes/A11-bst-ops.md"], "tags": ["operation", "bst"]},
    {"id": "evalExpr", "label": "evalExpr operation", "description": "Expr -> Int or Expr -> Maybe Int.", "ctor-pattern": "per-ctor case-fold", "files": ["interpreters/simple-arith.md"], "tags": ["operation", "interpreter"]},
    {"id": "circuit", "label": "circuit translation", "description": "Expr -> Circuit (Mock Q5).", "ctor-pattern": "per-ctor structural rewrite to Nand", "files": ["archetypes/A05-adt-translation.md"], "tags": ["operation", "translation", "mock-q5"]},
    {"id": "isNBranching", "label": "isNBranching", "description": "Int -> Rose a -> Bool (Mock Q1).", "ctor-pattern": "length children == n && all rec children", "files": ["archetypes/A01-tree-recursion.md", "indexes/MOCK-Q-INDEX.md"], "tags": ["operation", "rose", "mock-q1"]},
    {"id": "prune", "label": "prune", "description": "Int -> Rose a -> Rose a (Mock Q1).", "ctor-pattern": "Branch (take n (map rec children))", "files": ["archetypes/A01-tree-recursion.md", "indexes/MOCK-Q-INDEX.md"], "tags": ["operation", "rose", "mock-q1"]},
    {"id": "labelTree-state", "label": "labelTree (State)", "description": "BT a -> BT (Int, a) via State Int.", "ctor-pattern": "fresh-thread", "files": ["cross-matrix/tree-x-state.md"], "tags": ["operation", "cross", "state"]},
    {"id": "mapMTree", "label": "mapMTree", "description": "Monad m => (a -> m b) -> BT a -> m (BT b).", "ctor-pattern": "do { l <- rec; v <- f x; r <- rec; pure (Fork v l r) }", "files": ["cross-matrix/tree-x-generic-monad.md"], "tags": ["operation", "cross", "monad"]},
