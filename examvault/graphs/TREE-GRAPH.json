  },
  "nodes": [
    {"id": "BT", "label": "Binary tree (BT)", "description": "data BT a = Empty | Fork a (BT a) (BT a) — standard binary tree.", "ctor-pattern": "Empty | Fork", "files": ["trees/binary-tree.md", "archetypes/A01-tree-recursion.md"], "tags": ["core-tree", "tier-1"]},
    {"id": "BST", "label": "Binary search tree (BST)", "description": "BT a with Ord-invariant: in-order traversal is strictly sorted.", "ctor-pattern": "Empty | Fork (invariant: Ord)", "files": ["trees/bst.md", "archetypes/A11-bst-ops.md"], "tags": ["core-tree", "tier-2"]},
    {"id": "Rose-Data2", "label": "Rose tree (Data2 form)", "description": "data Rose a = Branch a [Rose a] — value at EVERY node.", "ctor-pattern": "Branch a [Rose a]", "files": ["trees/rose-tree.md"], "tags": ["rose", "tier-1"]},
    {"id": "Rose-Mock", "label": "Rose tree (Mock form)", "description": "data Rose a = Leaf a | Branch [Rose a] — value at LEAVES only.", "ctor-pattern": "Leaf a | Branch [Rose a]", "files": ["trees/rose-tree.md", "indexes/MOCK-Q-INDEX.md"], "tags": ["rose", "mock-q1", "tier-1"]},
    {"id": "Expr-Arith", "label": "Expression tree (arithmetic)", "description": "data Expr = Val Int | Add Expr Expr | Mul Expr Expr | Sub Expr Expr | Neg Expr — arithmetic AST.", "ctor-pattern": "Val | Add | Mul | Sub | Neg", "files": ["trees/expression-tree.md", "interpreters/simple-arith.md"], "tags": ["expr", "tier-1"]},
    {"id": "Expr-Logic", "label": "Expression tree (logical)", "description": "data Expr = Var Char | Not Expr | And Expr Expr | Or Expr Expr | Implies Expr Expr — Mock Q5 logical AST.", "ctor-pattern": "Var | Not | And | Or | Implies", "files": ["trees/expression-tree.md", "indexes/MOCK-Q-INDEX.md"], "tags": ["expr", "mock-q5", "tier-1"]},
    {"id": "Expr-Env", "label": "Expression tree (with env)", "description": "data Expr = Lit Int | Var String | Add | Mul | Let String Expr Expr — env-eval variant.", "ctor-pattern": "Lit | Var | Add | Mul | Let", "files": ["trees/expression-tree.md", "archetypes/A08-env-eval.md"], "tags": ["expr", "env", "tier-1"]},
    {"id": "Circuit", "label": "Circuit ADT", "description": "data Circuit = Input Char | Nand Circuit Circuit — Mock Q5 target.", "ctor-pattern": "Input | Nand", "files": ["archetypes/A05-adt-translation.md", "indexes/MOCK-Q-INDEX.md"], "tags": ["circuit", "mock-q5"]},
    {"id": "Game-tree", "label": "Game tree", "description": "Tree-of-grids for game-tree search (TTT minimax).", "ctor-pattern": "Node Grid [Game-tree]", "files": ["archetypes/A23-mini-game.md"], "tags": ["game", "tier-3"]},
    {"id": "Free-tree", "label": "Free [] a", "description": "Pure a | Free [Free [] a] — isomorphic to Rose-Mock.", "ctor-pattern": "Pure | Free", "files": ["monads/multi-effect.md", "indexes/ASSIGNMENT-INDEX.md"], "tags": ["free", "iso-rose", "tier-2"]},
    {"id": "Morse-tree", "label": "Morse-coding tree", "description": "data Tree = Empty | Branch (Maybe Char) Tree Tree — Assignment 2.", "ctor-pattern": "Empty | Branch (Maybe Char)", "files": ["archetypes/A12-rep-conversion.md", "archetypes/A07-codec-pair.md"], "tags": ["codec", "assignment-2"]},
    {"id": "Lazy-Nat", "label": "Lazy Nat (Peano)", "description": "data Nat = Zero | Succ Nat — Peano nat, lazy by default.", "ctor-pattern": "Zero | Succ", "files": ["archetypes/A18-lazy-memo.md"], "tags": ["lazy", "nat"]},
    {"id": "size", "label": "size operation", "description": "Count of nodes.", "ctor-pattern": "summing structural recursion", "files": ["question-families/tree-counting-family.md"], "tags": ["operation"]},
    {"id": "height", "label": "height operation", "description": "Max depth of any leaf.", "ctor-pattern": "max-of-rec + 1", "files": ["question-families/tree-counting-family.md"], "tags": ["operation"]},
