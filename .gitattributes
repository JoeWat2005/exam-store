# Normalize line endings: store LF in the repo for all text files.
* text=auto

# Force LF for shell scripts so they keep working after a clone on vLab/Linux
# (a CRLF shebang like "#!/bin/bash\r" fails on Unix).
*.sh text eol=lf

# Large model binary — tracked with Git LFS, treated as binary (no EOL conversion).
*.llamafile filter=lfs diff=lfs merge=lfs -text
